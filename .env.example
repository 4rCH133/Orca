# Reddit API — https://www.reddit.com/prefs/apps
# Create an "installed app" (no client secret needed for mobile)
EXPO_PUBLIC_REDDIT_CLIENT_ID=your_reddit_client_id_here
EXPO_PUBLIC_REDDIT_REDIRECT_URI=orca://auth/callback

# Supabase — https://supabase.com (create a new project, get these from Project Settings > API)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Upstash Redis — https://console.upstash.com (create a Redis DB, use REST API keys)
EXPO_PUBLIC_UPSTASH_REDIS_URL=https://your-db.upstash.io
EXPO_PUBLIC_UPSTASH_REDIS_TOKEN=your_upstash_rest_token
